# Copy to .env.local and fill in.

# Required to open /admin and read messages. Use a long random string (16+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Where your own email shows on the site and in the mailto fallback.
NEXT_PUBLIC_CONTACT_EMAIL=adeenswork@gmail.com

# Optional: store messages in Supabase instead of the local file (needed on Vercel,
# where the disk is read-only). Create the table with the SQL in README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=messages
